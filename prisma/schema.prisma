generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("USER") // ADMIN or USER
  position   String   @default("")
  department String   @default("")
  phone      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendances Attendance[]
}

model Attendance {
  id             String   @id @default(cuid())
  userId         String
  date           String   // YYYY-MM-DD format
  checkIn        String?  // HH:mm format
  checkOut       String?  // HH:mm format
  status         String   @default("PRESENT") // PRESENT, LATE, ABSENT
  note           String   @default("")
  checkInPhoto   String   @default("") // Base64 encoded photo on check-in
  checkOutPhoto  String   @default("") // Base64 encoded photo on check-out
  checkInLat     String   @default("") // Latitude on check-in
  checkInLng     String   @default("") // Longitude on check-in
  checkOutLat    String   @default("") // Latitude on check-out
  checkOutLng    String   @default("") // Longitude on check-out
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // One attendance record per user per day
}
