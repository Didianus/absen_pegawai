generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String @id @default(cuid())
  name       String
  email      String @unique
  password   String
  role       String @default("USER")
  position   String @default("")
  department String @default("")
  phone      String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances  Attendance[]
  barangMasuk  BarangMasuk[]
  barangKeluar BarangKeluar[]
}

model Attendance {
  id     String @id @default(cuid())
  userId String
  date   String

  checkIn  String?
  checkOut String?

  status String @default("PRESENT")
  note   String @default("")

  // PostgreSQL otomatis menggunakan TEXT
  checkInPhoto  String?
  checkOutPhoto String?

  checkInLat  String @default("")
  checkInLng  String @default("")
  checkOutLat String @default("")
  checkOutLng String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Barang {
  id        String @id @default(cuid())
  kode      String @unique
  nama      String
  kategori  String @default("")
  satuan    String @default("")
  stok      Int    @default(0)
  deskripsi String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barangMasuk  BarangMasuk[]
  barangKeluar BarangKeluar[]
}

model BarangMasuk {
  id         String @id @default(cuid())
  barangId   String
  jumlah     Int
  tanggal    String
  keterangan String @default("")
  penerimaId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang   Barang @relation(fields: [barangId], references: [id], onDelete: Cascade)
  penerima User   @relation(fields: [penerimaId], references: [id], onDelete: Cascade)
}

model BarangKeluar {
  id           String @id @default(cuid())
  barangId     String
  jumlah       Int
  tanggal      String
  keterangan   String @default("")
  pengeluarId  String
  penerimaNama String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang    Barang @relation(fields: [barangId], references: [id], onDelete: Cascade)
  pengeluar User   @relation(fields: [pengeluarId], references: [id], onDelete: Cascade)
}
